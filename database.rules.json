{
  "rules": {
    ".read": false,
    ".write": false,

    "rooms": {
      "$code": {
        ".read": true,

        // A room can only be CREATED here (never overwritten or deleted as a whole), and only by the person named as host.
        ".write": "auth != null && !data.exists() && newData.child('hostUid').val() === auth.uid",
        ".validate": "newData.hasChildren(['game', 'hostUid', 'data', 'status']) && newData.child('hostUid').val() === (data.exists() ? data.child('hostUid').val() : auth.uid)",

        "code":     { ".validate": "newData.isString() && newData.val().length <= 12" },
        "game":     { ".validate": "newData.isString() && newData.val().length <= 20" },
        "hostUid":  { ".validate": "newData.isString()" },
        "hostName": { ".validate": "newData.isString() && newData.val().length <= 60" },
        "title":    { ".validate": "newData.isString() && newData.val().length <= 60" },

        // Live scores: only the host, and never after the room is completed.
        "data": {
          ".write": "auth != null && root.child('rooms/' + $code + '/hostUid').val() === auth.uid && root.child('rooms/' + $code + '/status').val() !== 'completed'",
          ".validate": "newData.isString() && newData.val().length < 300000"
        },
        "updatedAt": {
          ".write": "auth != null && root.child('rooms/' + $code + '/hostUid').val() === auth.uid && root.child('rooms/' + $code + '/status').val() !== 'completed'",
          ".validate": "newData.isNumber()"
        },

        // 'live' -> 'completed' is a one-way door. Nothing can change the status once it is 'completed'.
        "status": {
          ".write": "auth != null && root.child('rooms/' + $code + '/hostUid').val() === auth.uid && data.val() !== 'completed'",
          ".validate": "newData.isString() && (newData.val() === 'live' || newData.val() === 'completed')"
        },

        "$other": { ".validate": false }
      }
    },

    // Audit log lives beside the room (so watching a room never downloads the whole log).
    // APPEND ONLY: an entry can be created once (!data.exists()) and can never be changed or deleted afterwards.
    // New entries are refused once the room is completed. The entry that completes the room is written in the same update.
    "audits": {
      "$code": {
        ".read": true,
        "$entry": {
          ".write": "auth != null && !data.exists() && newData.parent().parent().parent().child('rooms').child($code).child('hostUid').val() === auth.uid && root.child('rooms/' + $code + '/status').val() !== 'completed'",
          ".validate": "newData.hasChildren(['ts', 'uid', 'action']) && newData.child('ts').val() === now && newData.child('uid').val() === auth.uid",
          "ts":      { ".validate": "newData.isNumber()" },
          "uid":     { ".validate": "newData.isString()" },
          "name":    { ".validate": "newData.isString() && newData.val().length <= 60" },
          "action":  { ".validate": "newData.isString() && newData.val().length <= 20" },
          "summary": { ".validate": "newData.isString() && newData.val().length <= 400" },
          "totals":  { ".validate": "newData.isString() && newData.val().length <= 3000" },
          "hash":    { ".validate": "newData.isString() && newData.val().length <= 64" },
          "$other":  { ".validate": false }
        }
      }
    },

    "userRooms": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "profiles": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    // Floating emoji reactions. Anyone watching can send one (no sign-in needed, like presence). They are tiny, short lived
    // and have nothing to do with scores. A reaction can be created, never edited; it can only be removed after 15 seconds.
    "reactions": {
      "$code": {
        ".read": true,
        "$id": {
          ".write": "(!data.exists() && newData.exists()) || (data.exists() && !newData.exists() && now - data.child('ts').val() > 15000)",
          ".validate": "newData.hasChildren(['ts', 'k']) && newData.child('ts').val() === now",
          "ts":   { ".validate": "newData.isNumber()" },
          "k":    { ".validate": "newData.isString() && newData.val().matches(/^(hammer|fire|party|clap|splash|laugh|tomato|clown|skull|heart)$/)" },
          "from": { ".validate": "newData.isString() && newData.val().length <= 24" },
          "to":   { ".validate": "newData.isString() && newData.val().length <= 40" },
          "$other": { ".validate": false }
        }
      }
    },

    "presence": {
      "$code": {
        ".read": true,
        "$cid": {
          ".write": true,
          ".validate": "newData.isNumber()"
        }
      }
    }
  }
}
