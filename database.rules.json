{
  "rules": {
    ".read": false,
    ".write": false,

    "rooms": {
      "$code": {
        // Open to anyone who has the code, EXCEPT private rooms (they have a PIN in roomPins): those can only be read by the host
        // and by people who unlocked them with the right PIN (see "access" below).
        ".read": "!root.child('roomPins/' + $code).exists() || (auth != null && (root.child('access/' + $code + '/' + auth.uid).exists() || data.child('hostUid').val() === auth.uid))",

        // A room can only be CREATED here (never overwritten or deleted as a whole), only by the person named as host,
        // and only with a long random code (2 letters, then 4 + 4 letters/numbers, no 0 O 1 I L).
        ".write": "auth != null && !data.exists() && newData.child('hostUid').val() === auth.uid && $code.matches(/^[A-Z][A-Z]-[2-9A-HJKMNP-Z]{4}-[2-9A-HJKMNP-Z]{4}$/)",
        // Creating also has to stamp userMeta/<uid>/lastCreate in the same write; that is what limits one account to one new room per 10 seconds.
        ".validate": "newData.hasChildren(['game', 'hostUid', 'data', 'status']) && newData.child('hostUid').val() === (data.exists() ? data.child('hostUid').val() : auth.uid) && (data.exists() || newData.parent().parent().child('userMeta').child(auth.uid).child('lastCreate').val() === now)",

        "code":     { ".validate": "newData.isString() && newData.val().length <= 12" },
        "game":     { ".validate": "newData.isString() && newData.val().length <= 20" },
        "hostUid":  { ".validate": "newData.isString()" },
        "hostName": { ".validate": "newData.isString() && newData.val().length <= 60" },
        "title":    { ".validate": "newData.isString() && newData.val().length <= 60" },
        "private":  { ".validate": "newData.isBoolean()" },

        // Live scores: only the host, and never after the room is completed.
        "data": {
          ".write": "auth != null && root.child('rooms/' + $code + '/hostUid').val() === auth.uid && root.child('rooms/' + $code + '/status').val() !== 'completed'",
          ".validate": "newData.isString() && newData.val().length < 300000"
        },
        "updatedAt": {
          ".write": "auth != null && root.child('rooms/' + $code + '/hostUid').val() === auth.uid && root.child('rooms/' + $code + '/status').val() !== 'completed'",
          ".validate": "newData.isNumber()"
        },

        // 'live' -> 'completed' is a one-way door. Nothing can change the status once it is 'completed'.
        "status": {
          ".write": "auth != null && root.child('rooms/' + $code + '/hostUid').val() === auth.uid && data.val() !== 'completed'",
          ".validate": "newData.isString() && (newData.val() === 'live' || newData.val() === 'completed')"
        },

        "$other": { ".validate": false }
      }
    },

    // Audit log lives beside the room (so watching a room never downloads the whole log).
    // APPEND ONLY: an entry can be created once (!data.exists()) and can never be changed or deleted afterwards.
    // New entries are refused once the room is completed. The entry that completes the room is written in the same update.
    "audits": {
      "$code": {
        ".read": "!root.child('roomPins/' + $code).exists() || (auth != null && (root.child('access/' + $code + '/' + auth.uid).exists() || root.child('rooms/' + $code + '/hostUid').val() === auth.uid))",
        "$entry": {
          ".write": "auth != null && !data.exists() && newData.parent().parent().parent().child('rooms').child($code).child('hostUid').val() === auth.uid && root.child('rooms/' + $code + '/status').val() !== 'completed'",
          ".validate": "newData.hasChildren(['ts', 'uid', 'action']) && newData.child('ts').val() === now && newData.child('uid').val() === auth.uid",
          "ts":      { ".validate": "newData.isNumber()" },
          "uid":     { ".validate": "newData.isString()" },
          "name":    { ".validate": "newData.isString() && newData.val().length <= 60" },
          "action":  { ".validate": "newData.isString() && newData.val().length <= 20" },
          "summary": { ".validate": "newData.isString() && newData.val().length <= 400" },
          "totals":  { ".validate": "newData.isString() && newData.val().length <= 3000" },
          "hash":    { ".validate": "newData.isString() && newData.val().length <= 64" },
          "$other":  { ".validate": false }
        }
      }
    },

    "userRooms": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "$code": { ".validate": "newData.isNumber()" }
      }
    },
    "profiles": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "data": { ".validate": "newData.isString() && newData.val().length < 50000" },
        "$other": { ".validate": false }
      }
    },

    // Spam brake: when this account last created a room. A new room must stamp it, and it can only be stamped again 10 seconds later.
    "userMeta": {
      "$uid": {
        "lastCreate": {
          ".write": "auth != null && auth.uid === $uid && (!data.exists() || data.val() < now - 10000)",
          ".validate": "newData.isNumber() && newData.val() === now"
        },
        "$other": { ".validate": false }
      }
    },

    // Private rooms. roomPins/<code> holds a one-way hash of the room PIN. Nobody can read it. It is written once, together with the room, by the host.
    "roomPins": {
      "$code": {
        ".write": "auth != null && !data.exists() && newData.parent().parent().child('rooms').child($code).child('hostUid').val() === auth.uid",
        ".validate": "newData.isString() && newData.val().length === 64"
      }
    },
    // A viewer unlocks a private room by writing the hash of the PIN they typed here. It is only accepted when it equals the stored hash.
    "access": {
      "$code": {
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && newData.val() === root.child('roomPins/' + $code).val()",
          ".validate": "newData.isString() && newData.val().length === 64"
        }
      }
    },
    // Floating emoji reactions. Anyone watching can send one (no sign-in needed, like presence). They are tiny, short lived
    // and have nothing to do with scores. A reaction can be created, never edited; it can only be removed after 15 seconds.
    "reactions": {
      "$code": {
        ".read": true,
        "$id": {
          // only for rooms that exist, and every reaction also stamps rxLast (so a room gets at most about 4 reactions a second)
          ".write": "(!data.exists() && newData.exists() && root.child('rooms/' + $code + '/hostUid').exists()) || (data.exists() && !newData.exists() && now - data.child('ts').val() > 15000)",
          ".validate": "newData.hasChildren(['ts', 'k']) && newData.child('ts').val() === now && newData.parent().parent().parent().child('rxLast').child($code).val() === now",
          "ts":   { ".validate": "newData.isNumber()" },
          "k":    { ".validate": "newData.isString() && newData.val().matches(/^(hammer|fire|party|clap|splash|laugh|tomato|clown|skull|heart|peek|kiss|confused|sleepy|angry|thinking|walk|cheer)$/)" },
          "from": { ".validate": "newData.isString() && newData.val().length <= 24" },
          "to":   { ".validate": "newData.isString() && newData.val().length <= 40" },
          "$other": { ".validate": false }
        }
      }
    },

    "rxLast": {
      "$code": {
        ".write": "root.child('rooms/' + $code + '/hostUid').exists() && (!data.exists() || data.val() < now - 250)",
        ".validate": "newData.isNumber() && newData.val() === now"
      }
    },

    // Who is watching. Only for rooms that exist, only with the app's own id shape, only a timestamp.
    "presence": {
      "$code": {
        ".read": true,
        "$cid": {
          ".write": "root.child('rooms/' + $code + '/hostUid').exists()",
          ".validate": "newData.isNumber() && $cid.matches(/^c_[a-z2-9]{10}$/)"
        }
      }
    }
  }
}
